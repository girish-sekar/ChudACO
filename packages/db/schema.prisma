generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  discordId           String         @unique
  username            String
  avatarUrl           String?
  nextAcoAccountNumber Int           @default(1)
  notifyOnSuccess     Boolean        @default(true)
  notifyOnFailure     Boolean        @default(true)
  notifyWeeklySummary Boolean        @default(false)
  accountManagementMode String       @default("classic")
  termsVersion        String?
  termsAcceptedAt     DateTime?
  createdAt           DateTime       @default(now())
  checkouts           Checkout[]
  billingEntries      BillingEntry[]
  acoAccounts         AcoAccount[]
  acoProfiles         AcoProfile[]
  acoImapConfigs      AcoImapConfig[]
  acoCards            AcoCard[]
}

model Checkout {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  acoAccountId   String?
  acoAccount     AcoAccount?    @relation(fields: [acoAccountId], references: [id])
  retailer       String
  item           String
  qtyLabel       String
  price          Decimal        @db.Decimal(10, 2)
  status         CheckoutStatus @default(pending)
  trackingNumber String?
  orderNumber    String?
  ticketCode     String         @unique
  occurredAt     DateTime       @default(now())
  billingEntries BillingEntry[]
}

enum CheckoutStatus {
  success
  failed
  pending
}

model BillingEntry {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  checkoutId   String?
  checkout     Checkout?     @relation(fields: [checkoutId], references: [id])
  feeAmount    Decimal       @db.Decimal(10, 2)
  status       BillingStatus @default(due)
  paidMarkedAt DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime      @default(now())
}

enum BillingStatus {
  due
  paid
  overdue
}

model PricingRule {
  id              String   @id @default(cuid())
  category        String
  priceRangeLabel String
  minPrice        Decimal? @db.Decimal(10, 2)
  maxPrice        Decimal? @db.Decimal(10, 2)
  feeType         FeeType
  feeFlat         Decimal? @db.Decimal(10, 2)
  feePercent      Decimal? @db.Decimal(5, 2)
  sortOrder       Int      @default(0)
}

enum FeeType {
  flat
  percent
}

model AcoAccount {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  accountNumber     Int
  botProfileName    String    @unique
  label             String
  retailer          String
  email             String?
  emailProvider     String?
  onlyOneCheckout   Boolean   @default(true)
  shippingName      String?
  shippingPhone     String?
  shippingAddr      String?
  shippingCity      String?
  shippingState     String?
  shippingZip       String?
  billingSameAsShipping Boolean @default(true)
  billingName       String?
  billingPhone      String?
  billingAddr       String?
  billingCity       String?
  billingState      String?
  billingZip        String?
  loginEmail        String?
  status            AcoStatus @default(active)
  imapHost          String?
  imapPort          Int       @default(993)
  imapSecurity      String    @default("SSL/TLS")
  encryptedPassword String?
  encryptionIv      String?
  encryptedLoginPassword String?
  loginPasswordIv        String?
  lastSyncAt        DateTime?
  // Linked library entries; their values are copied onto this account when linked/edited.
  profileId         String?
  profile           AcoProfile?    @relation(fields: [profileId], references: [id], onDelete: SetNull)
  imapConfigId      String?
  imapConfig        AcoImapConfig? @relation(fields: [imapConfigId], references: [id], onDelete: SetNull)
  cardId            String?
  card              AcoCard?       @relation(fields: [cardId], references: [id], onDelete: SetNull)
  checkouts         Checkout[]
  cardOnFile        CardOnFile?
  retailerLogins    AcoRetailerLogin[]
  retailerCards     AcoRetailerCard[]
  retailerProfiles  AcoRetailerProfile[]

  @@unique([userId, accountNumber])
}

model AcoProfile {
  id                    String       @id @default(cuid())
  userId                String
  user                  User         @relation(fields: [userId], references: [id])
  name                  String
  shippingName          String?
  shippingPhone         String?
  shippingAddr          String?
  shippingCity          String?
  shippingState         String?
  shippingZip           String?
  billingSameAsShipping Boolean      @default(true)
  billingName           String?
  billingPhone          String?
  billingAddr           String?
  billingCity           String?
  billingState          String?
  billingZip            String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  accounts              AcoAccount[]
  retailerProfiles      AcoRetailerProfile[]

  @@unique([userId, name])
}

model AcoImapConfig {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  email             String
  emailProvider     String?
  imapHost          String
  imapPort          Int          @default(993)
  imapSecurity      String       @default("SSL/TLS")
  encryptedPassword String?
  encryptionIv      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  accounts          AcoAccount[]

  @@unique([userId, email])
}

// Masked details only; full card number/CVV live in the Google Sheets card vault tab.
model AcoCard {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  label          String
  cardholderName String
  cardBrand      String
  last4          String
  expMonth       Int
  expYear        Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accounts       AcoAccount[]
  retailerCards  AcoRetailerCard[]

  @@unique([userId, label])
}

model AcoRetailerLogin {
  id                   String     @id @default(cuid())
  acoAccountId         String
  acoAccount           AcoAccount @relation(fields: [acoAccountId], references: [id], onDelete: Cascade)
  retailer             String
  loginEmail           String
  encryptedLoginPassword String?
  loginPasswordIv      String?
  enabled              Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([acoAccountId])
}

enum AcoStatus {
  active
  locked
  banned
}

model CardOnFile {
  id             String     @id @default(cuid())
  acoAccountId   String     @unique
  acoAccount     AcoAccount @relation(fields: [acoAccountId], references: [id])
  cardBrand      String?
  last4          String?
  expMonth       Int?
  expYear        Int?
  cardholderName String?
  updatedAt      DateTime   @updatedAt
}

model AcoRetailerCard {
  id             String     @id @default(cuid())
  acoAccountId   String
  acoAccount     AcoAccount @relation(fields: [acoAccountId], references: [id], onDelete: Cascade)
  retailer       String
  cardId         String?
  card           AcoCard?   @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cardBrand      String?
  last4          String?
  expMonth       Int?
  expYear        Int?
  cardholderName String?
  updatedAt      DateTime   @updatedAt

  @@unique([acoAccountId, retailer])
  @@index([acoAccountId])
}

// Overrides the account's default profile for one retailer; values are read from the profile, never copied.
model AcoRetailerProfile {
  id           String     @id @default(cuid())
  acoAccountId String
  acoAccount   AcoAccount @relation(fields: [acoAccountId], references: [id], onDelete: Cascade)
  retailer     String
  profileId    String
  profile      AcoProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([acoAccountId, retailer])
  @@index([profileId])
}

model PaymentMethod {
  id     String @id @default(cuid())
  key    String @unique
  label  String
  handle String
  note   String
}

model Retailer {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
