{
  "name": "@chudaco/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "seed": "dotenv -e ../../.env -- tsx seed.ts",
    "backfill:account-shipping": "dotenv -e ../../.env -- tsx migrations-scripts/backfill-account-shipping.ts",
    "backfill:account-number-bot-profile": "dotenv -e ../../.env -- tsx migrations-scripts/backfill-aco-account-number-and-bot-profile.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "schema": "./schema.prisma"
  }
}